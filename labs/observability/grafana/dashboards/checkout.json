{
  "uid": "baodium-checkout",
  "title": "Baodium / Checkout health",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Checkout request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "baodium-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(baodium_checkout_requests_total[30s]))",
          "legendFormat": "Checkout request rate"
        }
      ]
    },
    {
      "id": 2,
      "title": "Checkout error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "baodium-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(baodium_checkout_requests_total{status=~\"5..\"}[30s])) / sum(rate(baodium_checkout_requests_total[30s]))",
          "legendFormat": "Checkout error ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Checkout p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "baodium-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(baodium_checkout_duration_seconds_bucket[30s])))",
          "legendFormat": "Checkout p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active checkouts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "baodium-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "baodium_checkout_active_requests",
          "legendFormat": "Active checkouts"
        }
      ]
    }
  ]
}