{
  "name": "baodium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/convert-manuscript.mjs && node scripts/enhance-book-html.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "convert-book": "node scripts/convert-manuscript.mjs",
    "enhance-book": "node scripts/enhance-book-html.mjs",
    "verify:concepts": "npx --yes tsx scripts/verify-interactive-concepts.ts",
    "verify:play": "npx --yes tsx scripts/verify-play-engines.ts",
    "verify:ch1": "npx --yes tsx scripts/verify-ch1-engine.ts",
    "verify:labs": "npx --yes tsx scripts/verify-short-labs.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.19.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
