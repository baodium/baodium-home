# Chapter 1 live lab. Set these in Vercel for Production and Preview, then redeploy.
# NEXT_PUBLIC_ values are read when the site is built.

# Lab runner. Example: https://labs.baodium.com
# When this is empty, Live lab keeps the Killercoda card and the local Docker notes.
NEXT_PUBLIC_LAB_RUNNER_URL=

# Optional direct Lab Console URL, used only when the runner URL is empty.
NEXT_PUBLIC_LAB_URL_CH01=

# Killercoda scenario. Shown when the runner is unset or every slot is busy.
NEXT_PUBLIC_KILLERCODA_URL_CH01=
